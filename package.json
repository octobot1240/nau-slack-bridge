{
  "name": "claude-channel-slack",
  "version": "0.12.0",
  "description": "Slack channel for Claude Code — two-way chat via Socket Mode",
  "type": "module",
  "bin": "./server.ts",
  "scripts": {
    "start": "bun install --frozen-lockfile --no-summary && bun server.ts",
    "start:node": "npx tsx server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "@slack/socket-mode": "2.0.6",
    "@slack/web-api": "7.15.2",
    "tsx": "^4.22.4",
    "zod": "4.6.6"
  },
  "overrides": {
    "axios": "1.20.0",
    "brace-expansion": "5.0.12",
    "fast-uri": "3.1.9",
    "form-data": "^4.0.6",
    "ws": "^8.21.0",
    "hono": "4.13.14",
    "follow-redirects": "1.16.1",
    "@babel/core": "7.29.6",
    "baseline-browser-mapping": "2.11.0",
    "browserslist": "4.28.7",
    "ip-address": "10.7.4",
    "zod": "4.6.6",
    "@hono/node-server": "2.1.3",
    "body-parser": "2.4.0",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@types/bun": "1.3.11",
    "dependency-cruiser": "^17.3.10",
    "fast-check": "^4.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript": "5.9.3"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Jeremy Longshore",
    "email": "jeremy@intentsolutions.io"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jeremylongshore/claude-code-slack-channel.git"
  },
  "lint-staged": {
    "*.{ts,js,json}": "bunx @biomejs/biome check --write --no-errors-on-unmatched"
  }
}
